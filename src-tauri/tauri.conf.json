{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omniroute-rs",
  "version": "0.1.0",
  "identifier": "com.frdndo.omniroute-rs",
  "build": {
    "beforeDevCommand": "cd ../dashboard && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../dashboard && VITE_PROXY_BASE=http://127.0.0.1:20129 npm run build",
    "frontendDist": "../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "omniroute-rs — Smart AI Router",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/omniroute-server"]
  }
}
