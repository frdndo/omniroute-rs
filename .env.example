# omniroute-rs configuration template
# Copy to .env and adapt. All vars are optional.

# ── Server ─────────────────────────────────────────────────────────────
OMNIROUTE_PORT=20129
# OMNIROUTE_VERSION=0.1.0

# ── Upstream providers ─────────────────────────────────────────────────
# Format: provider=key1,key2;provider2=key3
# Multiple keys per provider = account rotation pool
OMNIROUTE_PROVIDER_KEYS="openai=sk-xxxx;claude=sk-yyyy;gemini=AIza-zzzz;deepseek=sk-wwww"
# Optional: override upstream base URL (add /v1 for OpenAI-compatible APIs)
# OMNIROUTE_BASE_URL_OPENAI=http://127.0.0.1:9099/v1

# ── Gateway auth (clients hitting /v1/*) ───────────────────────────────
# Comma-separated bearer keys. Additional keys can be created via /admin/api-keys.
OMNIROUTE_API_KEYS="sk-gateway-1,sk-gateway-2"

# ── Admin API (/admin/*) ───────────────────────────────────────────────
# REQUIRED for admin endpoints; unset = /admin/* returns 503
OMNIROUTE_ADMIN_KEYS="sk-admin-change-me"

# ── Security ───────────────────────────────────────────────────────────
# Comma-separated allowed Host headers. Empty = allow all (dev only!)
# OMNIROUTE_ALLOWED_HOSTS="localhost,127.0.0.1,proxy.example.com"

# ── Database ───────────────────────────────────────────────────────────
# OMNIROUTE_DB_PATH=./data/omniroute.db

# ── Logging ────────────────────────────────────────────────────────────
RUST_LOG=info
